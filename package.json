{
  "name": "traffic-observe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env tools/migrate.ts",
    "test": "npx vitest run",
    "typecheck": "npx tsc -p tsconfig.json",
    "lint": "npx biome check ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
