# mysql://user:pass@host:port/db — a database of its own in tag-db (docs/README.md).
TRAFFIC_DB_URL=mysql://traffic_observe:CHANGE_ME@127.0.0.1:13306/traffic_observe
TRAFFIC_PORT=18150
TRAFFIC_HOST=127.0.0.1
# Similarweb requests a run may send. 0 = fetch nothing (keep 0 while tag still calls Similarweb itself).
TRAFFIC_RUN_BUDGET=0
# Minute of the hour the worker runs (tag used :35).
TRAFFIC_RUN_MINUTE=35
# Service tokens, at least 32 characters: TRAFFIC_TOKEN_<REQUESTER>=...
# TRAFFIC_TOKEN_TAG=
# TRAFFIC_TOKEN_BLOG=
# Google sign-in for /watch/ (same OAuth client as tag). Unset = no sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
TRAFFIC_PUBLIC_ORIGIN=https://traffic.observe.tw
# Administrators: manage sites and view full traffic data without the 30-row limit.
TRAFFIC_ADMIN_EMAILS=

# Google Sheet id of the 網域對照表 (name → domain for name-only sheet rows); anyone with the link can view.
TRAFFIC_DOMAIN_SHEET_ID=
