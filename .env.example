# mysql://user:pass@host:port/db — a database of its own in tag-db (docs/README.md).
TRAFFIC_DB_URL=mysql://traffic_observe:CHANGE_ME@127.0.0.1:13306/traffic_observe
TRAFFIC_PORT=18150
TRAFFIC_HOST=127.0.0.1
# Similarweb requests a run may send. 0 = fetch nothing (keep 0 while tag still calls Similarweb itself).
TRAFFIC_RUN_BUDGET=0
# Optional local weekly cap (UTC Monday reset). Default 15; 0 disables requests.
# Set auto to rely on actual refusals/backoff without a fixed local weekly cap.
# The extension UI's 15/25 views do not establish the data endpoint's quota.
TRAFFIC_WEEKLY_BUDGET=15
# Generic monthly collection: target auto = previous UTC month; persisted old gaps remain visible.
TRAFFIC_COLLECTION_ENABLED=1
TRAFFIC_TARGET_MONTH=auto
# Automatically prioritize the top domestic sites by prior-month Taiwan visits; editors may override.
TRAFFIC_CORE_DOMAINS=100
TRAFFIC_COLLECTION_MAX_ATTEMPTS=3
TRAFFIC_COLLECTION_RETRY_HOURS=72
# Shared local safeguards, NOT a confirmed provider quota. All callers count, including manual requests.
TRAFFIC_HOURLY_BUDGET=15
TRAFFIC_MIN_INTERVAL_SECONDS=240
# Before any target-month profile is received, collection mode allows only one probe per 24 hours.
# With collection mode disabled, new domains may get their first fetch within the shared limits.
TRAFFIC_PROBE_INTERVAL_HOURS=24
# Shared recovery for Similarweb 429; these waits are local choices, NOT provider quota/reset rules.
TRAFFIC_ADAPTIVE_BACKOFF=1
TRAFFIC_BACKOFF_BASE_HOURS=2
TRAFFIC_BACKOFF_MAX_HOURS=24
TRAFFIC_RECOVERY_INTERVAL_MINUTES=15
TRAFFIC_RECOVERY_SUCCESSES=3
TRAFFIC_RECOVERY_DAILY_BUDGET=3
# Optional single comparison: at most one existing recovery request per direct/JP/SG exit.
# Empty disables it. Never change the ID just to repeat a completed comparison.
TRAFFIC_EGRESS_EXPERIMENT=
# Legacy fallback only when adaptive mode is disabled. Valid Retry-After always takes precedence.
TRAFFIC_QUOTA_COOLDOWN_HOURS=168
# The Similarweb extension install id sent in X-Sw-Ctx (any UUID, kept fixed). Unset = a new one per start.
TRAFFIC_SIMILARWEB_DEVICE_ID=
# Minute of the hour the worker runs (tag used :35).
TRAFFIC_RUN_MINUTE=35
# Website homepage technology scans; independent of Similarweb, no Similarweb quota.
# One persisted batch per 24 hours, up to 100 domains, at least 10 seconds between domains.
TRAFFIC_TECH_BUDGET=100
TRAFFIC_TECH_INTERVAL_HOURS=24
TRAFFIC_TECH_PAUSE_SECONDS=10
TRAFFIC_TECH_MANUAL_CACHE_HOURS=24
# Cloudflare Radar API remains daily, with slower requests; no Similarweb quota.
TRAFFIC_RADAR_PAUSE_SECONDS=10
# Service tokens, at least 32 characters: TRAFFIC_TOKEN_<REQUESTER>=...
# TRAFFIC_TOKEN_TAG=
# TRAFFIC_TOKEN_BLOG=
# Google sign-in for /watch/ (same OAuth client as tag). Unset = no sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
TRAFFIC_PUBLIC_ORIGIN=https://site.observe.tw
# Administrators: manage sites and view full traffic data without the 30-row limit.
TRAFFIC_ADMIN_EMAILS=

# Google Sheet id of the 網域對照表 (name → domain for name-only sheet rows); anyone with the link can view.
TRAFFIC_DOMAIN_SHEET_ID=

# Community observations are stored separately; adoption is opt-in and trusted nodes only.
TRAFFIC_COMMUNITY_ENABLED=0
# At least 32 random characters; server signing key, never sent to contributors.
TRAFFIC_CONTRIBUTOR_SECRET=
# Explicit trust scores; unknown nodes never enter public metrics. Example: node-a:10,node-b:5
TRAFFIC_CONTRIBUTOR_TRUST=
# Queue-only canary; changes no rate caps, exits, identities or refusal backoff.
TRAFFIC_QUEUE_OPTIMIZATION=0
TRAFFIC_QUEUE_CANARY=initial-fair-queue
TRAFFIC_QUEUE_CANARY_HOURS=24
TRAFFIC_COLLECTION_REFRESH_HOURS=720
