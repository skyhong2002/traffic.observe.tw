[Unit]
Description=site.observe.tw worker: the machine's only Similarweb requester (hourly)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/traffic.observe.tw
EnvironmentFile=%h/Projects/traffic.observe.tw/.env
Environment=NODE_ENV=production
ExecStart=%h/.local/bin/node src/worker.ts
# A run takes at most five minutes; let it finish.
TimeoutStopSec=330
Restart=always
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
