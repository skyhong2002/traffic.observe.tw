{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "tools/**", "test/**", "*.ts", "*.json", "!package-lock.json", "!data"], "ignoreUnknown": true },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noParameterAssign": "off", "useTemplate": "off", "noNonNullAssertion": "off" },
      "complexity": { "useLiteralKeys": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      "includes": ["src/style.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    }
  ]
}
